{
  "version": 2,
  "buildCommand": "node scripts/trainInternationalFriendlies.js && node scripts/prebuildBrackets.js",
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "data/**",
          "model/**",
          "public/**",
          "src/**"
        ],
        "excludeFiles": [
          "data/teams/history/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ]
}
